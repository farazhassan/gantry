# Copy this file to .env.local (gitignored) and adjust if needed.

# URL of the Gantry AG-UI server's /agui endpoint (see ../main.go).
# Only read by the server-side Runtime route (app/api/copilotkit/route.ts) --
# the browser never talks to this URL directly.
GANTRY_AGUI_URL=http://localhost:8080/agui
